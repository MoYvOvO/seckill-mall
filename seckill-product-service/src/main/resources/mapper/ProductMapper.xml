<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seckill.seckillproductservice.mapper.ProductMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.seckill.seckillproductservice.entity.Product">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="price" property="price" />
        <result column="seckill_price" property="seckillPrice" />
        <result column="stock" property="stock" />
        <result column="image" property="image" />
        <result column="seckill_start" property="seckillStart" />
        <result column="seckill_end" property="seckillEnd" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, description, price, seckill_price, stock, image, seckill_start, seckill_end, status, create_time, update_time
    </sql>
    <update id="deductStock">
    UPDATE product
    SET stock = stock - #{quantity}
    WHERE id = #{productId} AND stock >= #{quantity}
   </update>
</mapper>
